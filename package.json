{
  "name": "@withworkspace/ui-lib",
  "version": "0.2.0",
  "description": "The page's side of ws's frame protocol: what a plugin's app talks to ws through, the protocol's types, and a fake host to test against",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withworkspace/ui-lib.git"
  },
  "homepage": "https://github.com/withworkspace/ui-lib#readme",
  "bugs": "https://github.com/withworkspace/ui-lib/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "PROTOCOL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
